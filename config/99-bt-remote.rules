# ==============================================================================
# ArcadiaOS: Low-latency Udev rules for Bluetooth TV Remotes (G9N9N / Generic BLE)
# ==============================================================================
# Ensure user access to input event nodes for responsive remote navigation
SUBSYSTEM=="input", ATTRS{name}=="*Remote*", MODE="0666", ENV{ID_INPUT_KEY}="1"
SUBSYSTEM=="input", ATTRS{name}=="*G9N9N*", MODE="0666", ENV{ID_INPUT_KEY}="1"
SUBSYSTEM=="input", ATTRS{name}=="Chromecast*", MODE="0666", ENV{ID_INPUT_KEY}="1"
# Enable power wakeups from Bluetooth remote buttons
ACTION=="add", SUBSYSTEM=="bluetooth", ATTR{power/wakeup}="enabled"
